# Etiquetas de analítica. Sin estas variables la página no carga ningún script
# de terceros. Copia este archivo a `.env` y rellena lo que uses.
#
# El prefijo PUBLIC_ es obligatorio: Astro solo expone al cliente las variables
# que lo llevan. Estos identificadores son públicos por naturaleza.

# Google Analytics 4 — formato G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Meta Pixel — solo dígitos
PUBLIC_META_PIXEL_ID=
