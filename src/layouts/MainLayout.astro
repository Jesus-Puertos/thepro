---
import AnalyticsScripts from '@/components/layout/AnalyticsScripts.astro';
import SeoHead, { type BreadcrumbItem } from '@/components/layout/SeoHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  imageAlt?: string;
  canonicalPath?: string;
  author?: string;
  publishedDate?: string;
  type?: 'website' | 'article';
  keywords?: string;
  /** Para páginas legales en borrador y la 404. */
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  isHomePage?: boolean;
}

const seoProps = Astro.props as Props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <SeoHead {...seoProps} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {/* Compuerta de animación: sin esta clase todo el contenido es visible. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        } catch (error) {
          return;
        }
        root.classList.add('motion-ready');
        // Failsafe: si GSAP no llega a arrancar, se restaura la visibilidad.
        window.setTimeout(function () {
          if (!root.classList.contains('motion-armed')) {
            root.classList.remove('motion-ready');
          }
        }, 2500);
      })();
    </script>

    <AnalyticsScripts />

  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only-focusable bg-red text-white fixed top-3 left-3 z-100 px-4 py-3 text-sm font-bold uppercase"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />

    <script>
      import { initAnalytics } from '@/lib/analytics';

      initAnalytics();

      // GSAP solo se descarga si realmente vamos a animar. Si la descarga falla
      // se retira la compuerta a mano, sin esperar al failsafe del <head>.
      if (document.documentElement.classList.contains('motion-ready')) {
        void import('@/lib/motion')
          .then(({ initMotion }) => initMotion())
          .catch(() => document.documentElement.classList.remove('motion-ready'));
      }
    </script>
  </body>
</html>
