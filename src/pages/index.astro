---
import MainLayout from '@/layouts/MainLayout.astro';

import HeroSection from '@/components/sections/HeroSection.astro';
import StatsSection from '@/components/sections/StatsSection.astro';
import ProblemSection from '@/components/sections/ProblemSection.astro';
import MethodSection from '@/components/sections/MethodSection.astro';
import IncludedSection from '@/components/sections/IncludedSection.astro';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import TestimonialsSection from '@/components/sections/TestimonialsSection.astro';
import CoachSection from '@/components/sections/CoachSection.astro';
import PricingSection from '@/components/sections/PricingSection.astro';
import FaqSection from '@/components/sections/FaqSection.astro';
import FinalCtaSection from '@/components/sections/FinalCtaSection.astro';
---

<MainLayout
  isHomePage
  ogTitle="Deja de jugar sin un plan. Alcanza tu Prime."
  ogDescription="Coaching, sesiones intensivas, cursos y comunidad para mejorar tu nivel en Apex Legends."
>
  <HeroSection />
  <StatsSection />
  <ProblemSection />
  <MethodSection />
  <IncludedSection />
  <ProcessSection />
  <TestimonialsSection />
  <CoachSection />
  <PricingSection />
  <FaqSection />
  <FinalCtaSection />
</MainLayout>
