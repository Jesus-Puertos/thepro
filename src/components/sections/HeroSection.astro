---
import { Image } from 'astro:assets';

import Container from '@/components/layout/Container.astro';
import PrimaryButton from '@/components/ui/PrimaryButton.astro';
import PlatformStrip from '@/components/ui/PlatformStrip.astro';
import GhostText from '@/components/ui/GhostText.astro';
import HeroExperience from '@/components/islands/HeroExperience';
import { offer } from '@/data/site';
import { heroProofItems } from '@/data/stats';

import coach from '@assets/the_pro_sin_fondo.png';
---

<section
  id="top"
  class="hero relative isolate flex min-h-svh flex-col overflow-hidden pt-(--header-h)"
>
  {/* ---- Capas de fondo. Todas decorativas y siempre presentes: el hero
        nunca depende de JavaScript ni de WebGL para verse completo. ---- */}

  <div aria-hidden="true" class="hero-beams"></div>
  <div aria-hidden="true" class="tech-grid"></div>

  <GhostText
    text="PRIME"
    class="top-[26%] left-1/2 -translate-x-1/2 lg:top-[18%] lg:left-[42%]"
    parallax={0.08}
  />

  {/* Chevron inspirado en la "A": es la forma que también dibuja la escena 3D,
      así el fallback y la versión con WebGL cuentan lo mismo. */}
  <svg
    aria-hidden="true"
    viewBox="0 0 200 160"
    class="hero-chevron"
    fill="none"
    stroke="currentColor"
  >
    <path d="M100 10 L190 152 L150 152 L100 70 L50 152 L10 152 Z" stroke-width="0.9"></path>
    <path d="M100 40 L154 128 L128 128 L100 84 L72 128 L46 128 Z" stroke-width="0.6"></path>
  </svg>

  {/* Escena 3D: se monta solo si el dispositivo puede con ella. */}
  <div aria-hidden="true" class="hero-canvas">
    <HeroExperience client:idle />
  </div>

  {/* The Pro, recortado con transparencia real e integrado con máscaras. */}
  <div aria-hidden="true" class="hero-coach">
    <div class="glow-red hero-coach-glow"></div>
    <Image
      src={coach}
      alt=""
      widths={[420, 640, 900, 1024]}
      sizes="(min-width: 1024px) 46vw, 92vw"
      loading="eager"
      class="hero-coach-image"
    />
  </div>

  <div aria-hidden="true" class="hero-scrim"></div>
  <div aria-hidden="true" class="noise-layer"></div>
  <div aria-hidden="true" class="hero-scan anim-scan"></div>

  {/* ---- Contenido ---- */}

  <Container class="relative z-20 flex flex-1 flex-col justify-center py-8 lg:py-10">
    <div class="grid lg:grid-cols-12">
      {/* 7 de 12 columnas también en xl: con 6 el titular se parte en cuatro
          líneas y el CTA se sale del primer pantallazo. */}
      <div class="flex flex-col items-start gap-5 sm:gap-6 lg:col-span-7">
        <p class="eyebrow tick-red" data-reveal="fade" data-hero style="--hero-delay:60ms">
          Programa de coaching para Apex Legends
        </p>

        <h1 class="h1 text-white">
          <span class="line-mask"><span data-hero-line style="--hero-delay:140ms">Deja de jugar</span></span>
          <span class="line-mask"><span data-hero-line style="--hero-delay:220ms">sin un plan.</span></span>
          <span class="line-mask"
            ><span data-hero-line class="text-outline-gold" style="--hero-delay:300ms">Alcanza tu Prime.</span></span
          >
        </h1>

        <p class="lead max-w-2xl" data-reveal="up" data-hero style="--hero-delay:460ms">
          Coaching, sesiones intensivas, cursos y comunidad para ayudarte a identificar tus
          errores, tomar mejores decisiones y mejorar tu nivel sin importar cuánto tiempo
          puedas jugar.
        </p>

        <div
          class="flex w-full flex-col gap-4 pt-1 sm:flex-row sm:items-stretch"
          data-reveal="up"
          data-hero
          style="--hero-delay:560ms"
        >
          <div class="panel shrink-0" style="--cut:10px">
            <div class="panel-inner flex flex-col justify-center px-5 py-3">
              <span class="label-tech text-muted">Membresía mensual</span>
              <span class="display text-white mt-1 text-[2rem] leading-none">
                $500 <span class="text-base align-top">MXN</span>
              </span>
            </div>
          </div>

          <PrimaryButton
            href={offer.checkoutUrl}
            external
            size="lg"
            track="hero_cta_click"
            class="grow sm:max-w-sm"
          >
            Quiero empezar mi entrenamiento
          </PrimaryButton>
        </div>

        <div class="flex flex-col gap-3 pt-2" data-reveal="up" data-hero style="--hero-delay:660ms">
          {/* Microprueba. Los datos viven en src/data/stats.ts, incluido el
              pendiente de confirmar sobre el significado de "221 jugadores". */}
          <p class="body-text-sm flex flex-wrap items-center gap-x-2.5 gap-y-1">
            {
              heroProofItems.map((item, i) => (
                <>
                  {i > 0 && <span aria-hidden="true" class="bg-red/60 h-1 w-1" />}
                  <span class={i === 0 ? 'text-white/80 font-semibold' : undefined}>{item}</span>
                </>
              ))
            }
          </p>

          <PlatformStrip />
        </div>
      </div>
    </div>
  </Container>

  <div class="relative z-20 hidden pb-8 lg:block">
    <Container class="flex items-center gap-3">
      <span aria-hidden="true" class="bg-red/70 anim-tick h-px w-10"></span>
      <span class="label-tech">Desliza para ver el método</span>
    </Container>
  </div>
</section>

<style>
  /* ==========================================================================
     Hero — CSS nativo
     Máscaras, haces de luz y composición asimétrica. Nada de esto se expresa
     con comodidad en clases utilitarias.
     ========================================================================== */

  .hero {
    background-color: var(--color-background);
  }

  /* Fallback visual permanente: haces de luz roja + horizonte.
     Es lo que se ve mientras (o si nunca) carga la escena 3D. */
  .hero-beams {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 62% 46% at 78% 26%,
        rgb(217 45 39 / 0.24) 0%,
        rgb(143 23 20 / 0.09) 42%,
        transparent 72%
      ),
      radial-gradient(
        ellipse 40% 30% at 12% 82%,
        rgb(214 166 44 / 0.09) 0%,
        transparent 68%
      ),
      conic-gradient(
        from 195deg at 72% 8%,
        transparent 0deg,
        rgb(217 45 39 / 0.07) 14deg,
        transparent 30deg,
        transparent 340deg,
        rgb(241 239 232 / 0.035) 352deg,
        transparent 360deg
      ),
      linear-gradient(to bottom, #050505 0%, #0a0708 55%, #050505 100%);
  }

  .hero :global(.tech-grid) {
    z-index: 1;
  }

  .hero :global(.ghost-text) {
    z-index: 2;
  }

  .hero-chevron {
    position: absolute;
    z-index: 2;
    top: 8%;
    right: -18%;
    width: 118%;
    color: rgb(217 45 39 / 0.16);
    pointer-events: none;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  /* --- The Pro -------------------------------------------------------------- */

  /* En móvil The Pro entra por la esquina inferior derecha, no ocupa todo el
     ancho: así el titular, el precio y el CTA nunca quedan encima de la foto. */
  .hero-coach {
    position: absolute;
    z-index: 4;
    right: -12%;
    bottom: 0;
    left: auto;
    width: 72%;
    height: 40%;
    opacity: 0.6;
    pointer-events: none;
  }

  .hero-coach-glow {
    top: 6%;
    left: 50%;
    width: 78%;
    height: 78%;
    transform: translateX(-50%);
    opacity: 0.7;
  }

  .hero-coach-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
    /* Fotografía real del coach: se trata, no se distorsiona ni se recolorea
       hasta hacerla irreconocible. */
    filter: contrast(1.06) saturate(0.82) brightness(0.94);

    /* Desvanecido arriba y hacia el texto (izquierda). */
    -webkit-mask-image:
      linear-gradient(to top, black 52%, transparent 100%),
      linear-gradient(to left, black 72%, transparent 100%);
    mask-image:
      linear-gradient(to top, black 52%, transparent 100%),
      linear-gradient(to left, black 72%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  /* Velo de contraste: oscurece arriba (bajo el header) y abajo. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(5 5 5 / 0.5) 0%, transparent 34%),
      linear-gradient(
        to top,
        rgb(5 5 5 / 0.7) 0%,
        rgb(5 5 5 / 0.22) 24%,
        transparent 46%
      );
  }

  .hero :global(.noise-layer) {
    z-index: 6;
  }

  /* Línea de escaneo. */
  .hero-scan {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 7;
    height: 8%;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(217 45 39 / 0.05) 45%,
      rgb(217 45 39 / 0.16) 50%,
      rgb(217 45 39 / 0.05) 55%,
      transparent
    );
  }

  /* --- Composición de escritorio -------------------------------------------- */

  @media (min-width: 768px) {
    .hero-coach {
      right: 0;
      width: 58%;
      height: 78%;
      opacity: 1;
    }

    .hero-scrim {
      background: linear-gradient(
        to right,
        rgb(5 5 5 / 0.86) 0%,
        rgb(5 5 5 / 0.6) 34%,
        rgb(5 5 5 / 0.05) 62%,
        transparent 100%
      );
    }

    .hero-coach-image {
      /* Doble máscara: se funde por abajo y por la izquierda, hacia el texto. */
      -webkit-mask-image:
        linear-gradient(to bottom, black 78%, transparent 100%),
        linear-gradient(to left, black 82%, transparent 100%);
      mask-image:
        linear-gradient(to bottom, black 78%, transparent 100%),
        linear-gradient(to left, black 82%, transparent 100%);
    }
  }

  @media (min-width: 1024px) {
    .hero-coach {
      top: var(--header-h);
      width: 52%;
      max-width: 46rem;
      height: auto;
    }

    .hero-chevron {
      top: 2%;
      right: -6%;
      width: 72%;
    }
  }

  @media (min-width: 1536px) {
    .hero-coach {
      right: 4%;
    }
  }
</style>
