---
import { Image } from 'astro:assets';

import Container from '@/components/layout/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PrimaryButton from '@/components/ui/PrimaryButton.astro';
import Badge from '@/components/ui/Badge.astro';
import { offer } from '@/data/site';

import coachPhoto from '@assets/thepro.webp';

/**
 * Solo se publican datos confirmados en context.md §9.
 *
 * TODO(pendiente): antes de lanzar, pedir y añadir aquí — alias profesional,
 * rango máximo, equipos, torneos, años dando coaching, número de sesiones
 * impartidas y resultados medibles de alumnos. context.md advierte
 * explícitamente que la autoridad no puede apoyarse solo en "llevo seis años
 * jugando", así que este bloque queda deliberadamente corto hasta tenerlos.
 */
const confirmedFacts = [
  '6 años jugando Apex Legends',
  'Jugador profesional',
  'Coach del programa',
];
---

<section
  id="the-pro"
  class="bg-surface relative overflow-hidden border-y border-(--color-border) py-20 lg:py-28"
>
  <div aria-hidden="true" class="tech-grid opacity-60"></div>
  <div aria-hidden="true" class="noise-layer"></div>
  <div aria-hidden="true" class="glow-gold top-10 -left-32 h-96 w-96 opacity-70"></div>

  <Container class="relative">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal="left">
        <div class="coach-frame panel" style="--cut:24px">
          <div class="panel-inner frame-brackets frame-brackets--gold relative overflow-hidden">
            <Image
              src={coachPhoto}
              alt="The Pro, coach de The Apex Prime, retratado entre luces de neón"
              widths={[420, 640, 860]}
              sizes="(min-width: 1024px) 34vw, 90vw"
              loading="lazy"
              class="coach-photo"
            />
            <div aria-hidden="true" class="scanlines opacity-35"></div>

            <div
              class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-5"
            >
              <div>
                <p class="label-tech text-gold">Coach</p>
                <p class="display text-white text-2xl">The Pro</p>
              </div>
              <span aria-hidden="true" class="bg-red h-0.5 w-10"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-7 lg:col-span-7">
        <SectionHeading
          eyebrow="Experiencia competitiva convertida en método"
          index="06"
          lines={['Conoce', 'a The Pro.']}
          accentIndex={1}
        />

        <div class="flex flex-col gap-4">
          <p class="lead max-w-2xl" data-reveal="up">
            Llevo seis años jugando Apex Legends y cumplí el objetivo que me puse cuando
            empecé: convertirme en jugador profesional.
          </p>
          <p class="body-text max-w-2xl" data-reveal="up">
            Lo que aprendí en ese camino no estaba en ningún lado ordenado. Tuve que
            reconstruirlo partida a partida. The Apex Prime existe para que tú no tengas que
            hacerlo solo: mismo conocimiento, pero explicado, con un orden y con alguien que
            te dice qué corregir.
          </p>
          <p class="body-text max-w-2xl" data-reveal="up">
            No prometo rangos ni resultados garantizados. Prometo un método, feedback honesto
            y una comunidad donde puedas desarrollarte a tu ritmo.
          </p>
        </div>

        <ul class="flex flex-wrap gap-2.5" data-reveal="up">
          {confirmedFacts.map((fact) => <li><Badge tone="gold">{fact}</Badge></li>)}
        </ul>

        <div class="pt-2" data-reveal="up">
          <PrimaryButton
            href={offer.checkoutUrl}
            external
            track="pricing_cta_click"
            trackPayload={{ source: 'the_pro' }}
            class="w-full sm:w-auto"
          >
            Entrenar con The Pro
          </PrimaryButton>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .coach-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 28%;
    /* Tratamiento monocromo cálido, no una reinterpretación del color de piel. */
    filter: grayscale(0.55) contrast(1.1) brightness(0.92) saturate(0.9);
  }

  .coach-frame :global(.panel-inner) {
    background-color: var(--color-background);
  }
</style>
