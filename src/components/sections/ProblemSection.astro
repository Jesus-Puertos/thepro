---
import Container from '@/components/layout/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import GhostText from '@/components/ui/GhostText.astro';
import { problems } from '@/data/problems';
---

<section id="problema" class="relative overflow-hidden py-20 lg:py-28">
  <div aria-hidden="true" class="tech-grid opacity-60"></div>
  {/* `right-[3%]`, no negativo: con el desbordamiento anterior la sección
      recortaba la T final y "RESET" se leía como "RESE". */}
  <GhostText
    text="RESET"
    size="sm"
    variant="outline"
    class="top-6 right-[3%] hidden lg:block"
    parallax={0.1}
  />

  <Container class="relative">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+3rem)]">
          <SectionHeading
            eyebrow="El problema"
            index="01"
            lines={['Jugar más', 'no siempre significa', 'jugar mejor.']}
            accentIndex={2}
            description="Las horas por sí solas no corrigen nada. Sin identificar qué falla, se repite el mismo error durante meses."
          />
        </div>
      </div>

      <ul class="lg:col-span-7">
        {
          problems.map((problem) => (
            <li
              class="problem-row group border-t border-(--color-border) py-5 last:border-b"
              data-reveal="up"
            >
              <div class="flex items-start gap-4 sm:gap-6">
                <span class="label-tech text-red/80 mt-1 shrink-0 tabular-nums">
                  {problem.index}
                </span>
                <div class="flex flex-col gap-1.5">
                  <h3 class="h4 text-white">{problem.title}</h3>
                  <p class="body-text">{problem.description}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>

<style>
  /* Barrido rojo desde el borde izquierdo al pasar el cursor. */
  .problem-row {
    position: relative;
    transition: padding-left 260ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .problem-row::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-red);
    transition: width 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (hover: hover) {
    .problem-row:hover {
      padding-left: 0.75rem;
    }

    .problem-row:hover::before {
      width: 100%;
    }
  }
</style>
