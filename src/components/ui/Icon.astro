---
/**
 * Iconos para componentes Astro — cero JavaScript en el cliente.
 *
 * Los paths provienen de Lucide (licencia ISC, ya presente en el proyecto vía
 * `lucide-react`) y están inlineados para no hidratar React solo por un icono.
 * Dentro de las islas de React sí se importa `lucide-react` directamente.
 */
import type { IconName } from '@/types';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 20, strokeWidth = 1.75, class: className } = Astro.props;

