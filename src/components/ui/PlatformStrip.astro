---
/**
 * Compatibilidad de plataformas (context.md §4).
 *
 * Los logos de PlayStation, Xbox y Steam están inlineados desde `assets/` para
 * evitar cuatro peticiones extra y poder teñirlos con `currentColor`. Se usan de
 * forma nominativa: indican en qué plataformas funciona el programa. Switch no
 * tiene logo en `assets/`, así que se representa con un icono genérico de mando.
 * Ver `THIRD_PARTY_ASSETS.md`.
 */
import Icon from './Icon.astro';

interface Props {
  size?: 'sm' | 'md';
  showLabels?: boolean;
  class?: string;
}

const { size = 'sm', showLabels = true, class: className } = Astro.props;

const box = size === 'md' ? 'h-6 w-6' : 'h-[18px] w-[18px]';
const iconPx = size === 'md' ? 24 : 18;
