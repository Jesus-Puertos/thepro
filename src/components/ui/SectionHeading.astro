---
/**
 * Encabezado de sección con etiqueta técnica, índice y título en varias líneas.
 * El título se pasa como array para controlar los saltos de línea (Anton es muy
 * condensada y los cortes automáticos rompen el ritmo del titular).
 */
interface Props {
  eyebrow?: string;
  index?: string;
  lines: readonly string[];
  /** Índice de la línea que va en rojo. */
  accentIndex?: number;
  /** Índice de la línea con contorno dorado. */
  outlineIndex?: number;
  description?: string;
  align?: 'left' | 'center';
  as?: 'h2' | 'h3';
  id?: string;
  class?: string;
}

const {
  eyebrow,
  index,
  lines,
  accentIndex,
  outlineIndex,
  description,
  align = 'left',
  as: Tag = 'h2',
  id,
  class: className,
} = Astro.props as Props;

const isCenter = align === 'center';
---

<div
  class:list={[
    'flex flex-col gap-5',
    isCenter ? 'items-center text-center' : 'items-start',
    className,
  ]}
>
  {
    (eyebrow || index) && (
      <p
        class:list={['eyebrow flex items-center gap-3', isCenter && 'justify-center']}
        data-reveal="fade"
      >
        {index && <span class="text-red/90 font-bold tabular-nums">{index}</span>}
        {index && eyebrow && <span aria-hidden="true" class="bg-red/50 h-px w-6" />}
        {eyebrow && <span>{eyebrow}</span>}
      </p>
    )
  }

  <Tag id={id} class="h2">
    {
      lines.map((line, i) => (
        <span
          class:list={[
            'block',
            i === accentIndex && 'text-accent-red',
            i === outlineIndex && 'text-outline-gold',
          ]}
          data-reveal="up"
        >
          {line}
        </span>
      ))
    }
  </Tag>

  {
    description && (
      <p class:list={['lead max-w-2xl', isCenter && 'mx-auto']} data-reveal="up">
        {description}
      </p>
    )
  }
</div>
