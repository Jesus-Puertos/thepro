---
/**
 * Ilustración decorativa de fondo de sección.
 *
 * Tratamiento único para las tres piezas de Apex Legends que ya no son figuras
 * protagonistas: monocromo, muy poca opacidad y bordes desvanecidos con máscara,
 * para que aporten textura sin competir con el texto que va encima.
 *
 * Siempre decorativa: `alt=""` y `aria-hidden`. Requiere que la sección
 * contenedora tenga `position: relative` y `overflow: hidden`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** Clases de posición y tamaño, p. ej. "-right-16 top-10 w-[38rem]". */
  class: string;
  /**
   * 0–100. Sobre un fondo casi negro hace falta bastante más de lo que
   * parece: por debajo del 12 % la ilustración deja de leerse.
   */
  opacity?: number;
  /** Espeja la imagen para que "mire" hacia el contenido. */
  flip?: boolean;
  widths?: number[];
  sizes?: string;
}

const {
  src,
  class: className,
  opacity = 18,
  flip = false,
  widths = [420, 760],
  sizes = '(min-width: 1024px) 40vw, 70vw',
} = Astro.props as Props;
---

<div aria-hidden="true" class:list={['section-backdrop absolute', className]}>
  <Image
    src={src}
    alt=""
    widths={widths}
    sizes={sizes}
    loading="lazy"
    decoding="async"
    class="section-backdrop-img"
    style={`opacity:${opacity / 100};${flip ? 'transform:scaleX(-1);' : ''}`}
  />
</div>

<style>
  .section-backdrop {
    pointer-events: none;
    user-select: none;
  }

  .section-backdrop-img {
    width: 100%;
    height: auto;
    /* El brillo sube en vez de bajar: sobre negro, oscurecer la ilustración la
       hace desaparecer. Lo que se busca es que despegue del fondo. */
    filter: grayscale(1) contrast(1.15) brightness(1.3);
    /* Se funde por los cuatro lados, pero el desvanecido empieza tarde para no
       comerse media imagen. */
    mask-image: radial-gradient(ellipse 82% 82% at 50% 50%, #000 48%, transparent 92%);
  }
</style>
