---
/**
 * Etiquetas de terceros: GA4 y Meta Pixel.
 *
 * No se cargan a menos que exista la variable de entorno correspondiente, así
 * que en desarrollo y en cualquier despliegue sin configurar la página no envía
 * un solo byte a terceros.
 *
 *   PUBLIC_GA4_ID=G-XXXXXXXXXX
 *   PUBLIC_META_PIXEL_ID=000000000000000
 *
 * Ambas van con el prefijo `PUBLIC_` porque Astro solo expone al cliente las
 * variables que lo llevan, y estos identificadores son públicos por naturaleza:
 * se ven en el HTML de cualquier sitio que los use.
 *
 * `src/lib/analytics.ts` ya reenvía cada evento a `gtag` y a `fbq` si existen,
 * de modo que conectar una etiqueta no obliga a tocar ningún componente.
 *
 * ⚠️ PENDIENTE — consentimiento. Esto carga las etiquetas de inmediato. Para
 * cumplir con la LFPDPPP hace falta, como mínimo, que el aviso de privacidad
 * explique qué se recoge; y si alguna vez hay tráfico del EEE, un banner de
 * consentimiento previo. Ver PENDIENTES.md.
 */
const ga4Id = import.meta.env.PUBLIC_GA4_ID as string | undefined;
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined;

const hasGa4 = typeof ga4Id === 'string' && ga4Id.startsWith('G-');
const hasMeta = typeof metaPixelId === 'string' && /^\d{6,}$/.test(metaPixelId);
---

{
  hasGa4 && (
    <Fragment>
      <link rel="preconnect" href="https://www.googletagmanager.com" />
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
      <script is:inline define:vars={{ ga4Id }}>
        {`
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', ga4Id);
        `}
      </script>
    </Fragment>
  )
}

{
  hasMeta && (
    <Fragment>
      <script is:inline define:vars={{ metaPixelId }}>
        {`
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
          (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', metaPixelId);
          fbq('track', 'PageView');
        `}
      </script>
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          alt=""
          src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
        />
      </noscript>
    </Fragment>
  )
}
