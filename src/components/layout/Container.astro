---
/** Ancho de contenido consistente en toda la landing (context.md §13). */
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  size?: 'default' | 'narrow';
  class?: string;
}

// El cast es necesario porque `as` desde props impide a Astro inferir `Props`
// cuando el elemento raíz es dinámico.
const { as: Tag = 'div', size = 'default', class: className } = Astro.props as Props;

const widths = {
  default: 'max-w-content',
  narrow: 'max-w-4xl',
} as const;
---

<Tag class:list={['mx-auto w-full px-5 sm:px-8 lg:px-10', widths[size], className]}>
  <slot />
</Tag>
